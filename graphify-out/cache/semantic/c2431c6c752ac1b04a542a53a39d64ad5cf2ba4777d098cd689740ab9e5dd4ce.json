{"nodes": [{"id": "templates_base_base_template", "label": "Base Template (base.html)", "file_type": "code", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single layout shell loading Tailwind CDN, GSAP+ScrollTrigger, Lenis, KaTeX, and Google Fonts (Latin + Bengali pairs). Exposes title/extra_head/content/scripts blocks for child templates."}, {"id": "templates_base_global_search_modal", "label": "Global Search Modal (Ctrl+K)", "file_type": "code", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debounced (220ms) fetch to the search_api endpoint, grouped results (questions/notes/papers), keyboard navigation, scoped to the student's board & class."}, {"id": "templates_base_dark_mode_toggle", "label": "Dark Mode Toggle", "file_type": "code", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Theme class applied in a blocking head script before paint to prevent flash; color-scheme meta declared so Brave/Chrome do not force their own dark mode. Persisted in localStorage key py-theme."}, {"id": "templates_base_katex_math_rendering", "label": "KaTeX Math Rendering Setup", "file_type": "code", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loaded from CDN with SRI integrity hashes; exposes window.renderMath() so dynamically inserted content can re-render math. throwOnError:false keeps malformed teacher-entered LaTeX from breaking pages."}, {"id": "templates_base_gsap_lenis_animation", "label": "GSAP + Lenis Scroll Animation System", "file_type": "code", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces AOS: data-aos attributes are driven by GSAP ScrollTrigger; Lenis smooth scroll is wired into the GSAP ticker so both share one RAF loop."}, {"id": "templates_base_bn_digit_converter", "label": "Client-side Bangla Digit Converter", "file_type": "code", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When LANG is bn, walks all text nodes on DOMContentLoaded converting 0-9 to Bengali numerals, skipping SCRIPT/STYLE/INPUT/TEXTAREA/SELECT/CANVAS \u2014 a blanket conversion so individual templates need not localize digits."}, {"id": "templates_base_tailwind_brand_recolor", "label": "Tailwind Brand Recolor (blue->emerald, purple->teal)", "file_type": "rationale", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tailwind.config remaps the blue and purple palettes to emerald/teal values so the entire site was rebranded without editing thousands of existing utility classes in templates."}, {"id": "templates_base_layout", "label": "Base Template Layout (base.html)", "file_type": "code", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_base_template", "label": "Base Template (base.html)", "file_type": "code", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templates_base_template", "label": "Base Template (base.html)", "file_type": "code", "source_file": "templates/base.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "templates_base_base_template", "target": "includes_navbar_navbar", "relation": "references", "confi