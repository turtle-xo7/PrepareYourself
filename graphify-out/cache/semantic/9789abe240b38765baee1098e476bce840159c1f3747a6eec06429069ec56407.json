{"nodes": [{"id": "readme_prepareyourself_platform", "label": "PrepareYourself Platform", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bangladesh exam-prep platform for SSC & HSC students built by a 4-person Scrum team over one semester. Core value: adaptive board-specific practice, teacher grading, live contests, and curated study resources at an affordable price."}, {"id": "readme_question_bank", "label": "Question Bank Feature", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MCQ & CQ (Creative) questions filtered by board, class, subject, year, and chapter \u2014 mirrors how Bangladeshi board exams are actually organized."}, {"id": "readme_exam_engine", "label": "Exam Engine (MCQ + CQ phases)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timed MCQ phase followed by CQ written submission with photo upload per part (ka/kha/ga/gha) \u2014 replicates the real two-part SSC/HSC board exam structure."}, {"id": "readme_teacher_grading_system", "label": "Teacher Grading System", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified teacher accounts claim CQ submissions and grade per-part with comments, because creative questions cannot be auto-graded."}, {"id": "readme_contest_system", "label": "Contest System", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scheduled competitive exams with live leaderboards, ratings, coins, and badges."}, {"id": "readme_bilingual_ui", "label": "Bilingual UI (Bangla/English)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full interface in Bangla and English, user-selectable. Implemented as a LANG context variable checked inline in every template rather than Django i18n, keeping translations colocated with markup."}, {"id": "readme_tech_stack", "label": "Tech Stack", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Django 6.0.5 + Python 3.12; SQLite in dev with PostgreSQL via DATABASE_URL for production flexibility; Tailwind CDN + GSAP/Lenis for frontend; Anthropic API for AI note/MCQ generation and Gemini for OCR; Gunicorn + WhiteNoise for deployment without a separate static server."}], "edges": [{"source": "readme_prepareyourself_platform", "target": "contributing_contributing_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_prepareyourself_platform", "target": "github_pull_request_template_pr_template", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_prepareyourself_platform", "target": "workflows_ci_ci_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_prepareyourself_platform", "target": "requirements_runtime_dependencies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_prepareyourself_platform", "target": "requirements_dev_dev_dependencies", "relation": "references", "co