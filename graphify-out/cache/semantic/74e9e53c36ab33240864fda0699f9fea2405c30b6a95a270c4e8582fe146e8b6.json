{"nodes": [{"id": "manage_create_exam_paper_create_exam_paper", "label": "Create Exam Paper Template", "file_type": "code", "source_file": "templates/manage/create_exam_paper.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single form saving MCQ and CQ phases together. Three input paths feed the same form: manual rows, bulk text paste, and image OCR \u2014 minimizing teacher data-entry effort."}, {"id": "manage_create_exam_paper_preprocessimageforocr", "label": "preprocessImageForOCR", "file_type": "code", "source_file": "templates/manage/create_exam_paper.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser-side image preprocessing before Tesseract.js: upscale to 1800px min side, grayscale, then adaptive thresholding via an integral image (15px window, C=8) \u2014 improves OCR accuracy on photographed Bengali exam papers. OCR runs entirely in the browser because Tesseract.js is free (no server API cost)."}, {"id": "manage_create_exam_paper_parseandfill", "label": "parseAndFill (OCR text -> form)", "file_type": "code", "source_file": "templates/manage/create_exam_paper.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manage_create_exam_paper_parsebulkmcq", "label": "parseBulkMCQ (paste -> form)", "file_type": "code", "source_file": "templates/manage/create_exam_paper.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manage_create_exam_paper_addmcq", "label": "addMCQ (create_exam_paper.html)", "file_type": "code", "source_file": "templates/manage/create_exam_paper.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "manage_create_exam_paper_addcq", "label": "addCQ (create_exam_paper.html)", "file_type": "code", "s